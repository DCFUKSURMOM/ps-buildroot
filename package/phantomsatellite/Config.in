config BR2_PACKAGE_PHANTOMSATELLITE
    bool "phantom-satellite"
    depends on BR2_PACKAGE_DBUS_GLIB
    depends on BR2_PACKAGE_LIBGTK2
    depends on BR2_PACKAGE_ALSA_LIB
    depends on BR2_PACKAGE_XLIB_LIBXT
    depends on BR2_PACKAGE_PULSEAUDIO
    depends on BR2_PACKAGE_OPENSSL
    depends on BR2_PACKAGE_SQLITE
    depends on BR2_PACKAGE_ZLIB
    depends on BR2_PACKAGE_BZIP2
    depends on BR2_PACKAGE_LIBPNG
    depends on BR2_PACKAGE_LIBJPEG
    depends on BR2_PACKAGE_FREETYPE
    depends on BR2_PACKAGE_FONTCONFIG
    depends on BR2_PACKAGE_MESA3D
    depends on BR2_PACKAGE_HOST_PYTHON3
    help
      Phantom Satellite a fork of Pale Moon that aims to support
      older/niche platforms, without sacrificing support for more
      common/modern platforms. The name is a play on Pale Moon.
      Phantom = Pale (like a ghost)
      Satellite = Moon (the moon is a natural satellite)